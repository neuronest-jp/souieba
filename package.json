{
  "name": "souieba",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "mkdir -p web/dist && wrangler dev --var ENVIRONMENT:development",
    "build:web": "vue-tsc -p web/tsconfig.json --noEmit && vite build",
    "build": "pnpm build:web && wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "pnpm build:web && wrangler deploy",
    "preview": "pnpm build:web && wrangler dev --var ENVIRONMENT:development",
    "db:migrate:local": "wrangler d1 migrations apply souieba --local",
    "db:migrate:remote": "wrangler d1 migrations apply souieba --remote",
    "db:seed:local": "wrangler d1 execute souieba --local --file demo/fixtures/seed.sql",
    "db:seed:remote": "wrangler d1 execute souieba --remote --file demo/fixtures/seed.sql",
    "typecheck": "tsc -p worker/tsconfig.json --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:hook": "node scripts/check-hook.mjs"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.157.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
